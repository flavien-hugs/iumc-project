ENVIRONMENT=development
API_PREFIX=/api/v1

DATABASE_URL=postgresql+asyncpg://iumc:iumc@postgres:5432/iumc
REDIS_URL=redis://redis:6379/0

JWT_SECRET_KEY=change-me
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRES_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRES_DAYS=7

CORS_ALLOW_ORIGINS=["http://localhost:5173","http://localhost:5174","http://localhost:3000","http://localhost:3001"]

STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=/data/media
MAX_UPLOAD_MB=10

# SMTP : laissé vide, les e-mails sont journalisés (mode dev).
# SMTP_HOST=smtp.exemple.ci
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
SMTP_FROM=no-reply@iumc.ci

# Base des liens envoyés par e-mail (réinitialisation de mot de passe).
ADMIN_BASE_URL=http://localhost:3001
