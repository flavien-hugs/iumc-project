{
  "name": "iumc-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:website": "npm run dev --workspace=@iumc/website",
    "dev:admin": "npm run dev --workspace=@iumc/admin",
    "build": "npm run build --workspaces --if-present",
    "build:website": "npm run build --workspace=@iumc/website",
    "build:admin": "npm run build --workspace=@iumc/admin"
  }
}
